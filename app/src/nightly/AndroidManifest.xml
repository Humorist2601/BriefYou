<?xml version="1.0" encoding="utf-8"?>
<!-- Brief You Nightly only: a way to post a sample digest notification (see DigestPreviewReceiver). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="me.ash.reader.brief.notifications.DigestPreviewReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="me.ash.reader.brief.DIGEST_PREVIEW" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
