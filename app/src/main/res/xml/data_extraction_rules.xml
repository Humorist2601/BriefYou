<?xml version="1.0" encoding="utf-8"?>
<!-- Brief You: the same rules for Android 12 and newer, for cloud backup and for moving to a new
     phone. The database holds server logins, so it stays on the phone; the AI model is gigabytes and the offline copies are downloaded again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="offline/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="offline/" />
    </device-transfer>
</data-extraction-rules>
