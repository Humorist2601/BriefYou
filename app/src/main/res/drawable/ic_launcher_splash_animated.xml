<?xml version="1.0" encoding="utf-8"?>
<!-- The system splash's icon (Android 12+): icon A's front card, straight, tipping a little to the
     right as soon as it shows. The animated splash (BriefSplash) carries on from the tipped card.
     Same shape and place as ic_launcher_splash_screen. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group android:pivotX="54" android:pivotY="51" android:scaleX="0.8" android:scaleY="0.8" android:translateY="3">
                <group android:name="card" android:pivotX="54" android:pivotY="72" android:rotation="0">
                    <path android:pathData="M42,26H66A7,7 0 0 1 73,33V69A7,7 0 0 1 66,76H42A7,7 0 0 1 35,69V33A7,7 0 0 1 42,26Z" android:fillColor="@color/splash_card_front"/>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="card">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="3"
                android:duration="180"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
</animated-vector>
