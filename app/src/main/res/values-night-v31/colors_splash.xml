<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen colours from the wallpaper (Material You), dark theme: background a step
     lighter than the app's background, cards in the accent colour with the front one strongest
     (primary), lines and sparkle in the background colour so they look cut out. -->
<resources>
    <color name="splash_background">@android:color/system_neutral1_800</color>
    <color name="splash_card_back">@android:color/system_accent1_700</color>
    <color name="splash_card_middle">@android:color/system_accent1_500</color>
    <color name="splash_card_front">@android:color/system_accent1_200</color>
    <color name="splash_line">@android:color/system_neutral1_800</color>
    <color name="splash_sparkle">@android:color/system_neutral1_800</color>
</resources>
