<?xml version="1.0" encoding="utf-8"?>
<!-- Android 14+, dark theme: the splash background is the system's surface container (tone 12),
     a little lighter than the app's background (tone 6). The lines and sparkle match it. -->
<resources>
    <color name="splash_background">@android:color/system_surface_container_dark</color>
    <color name="splash_line">@android:color/system_surface_container_dark</color>
    <color name="splash_sparkle">@android:color/system_surface_container_dark</color>
</resources>
