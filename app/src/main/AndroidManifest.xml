<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Brief You: read aloud in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Brief You: the AI model downloads in the background, with a progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />

            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TRANSLATE" />
        </intent>
    </queries>

    <!-- Brief You: backup rules (dataExtractionRules, fullBackupContent) and predictive back -->
    <application
        android:name=".infrastructure.android.AndroidApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/read_you"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reader"
        android:usesCleartextTraffic="true">

        <!-- Brief You: lets LiteRT-LM use the GPU for on-device summaries (optional on devices without it). -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name=".ui.widget.WidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.Reader">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Brief You: video picture-in-picture and full screen turn and resize the screen without restarting it. -->
        <activity
            android:name=".infrastructure.android.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:supportsPictureInPicture="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.Reader"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/rss+xml" />
                <data android:mimeType="application/atom+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Brief You: named Add Feed in the Share menu (next to Read Later) -->
            <intent-filter android:label="@string/share_add_feed_label">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
            </intent-filter>
            <!-- Brief You: named Add Feed in the Share menu (next to Read Later) -->
            <intent-filter android:label="@string/share_add_feed_label">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Brief You: the launcher entry keeps its old name (me.ash.reader...), so the icon on the
             home screen and shortcuts made from it survive the package rename. -->
        <activity-alias
            android:name="me.ash.reader.infrastructure.android.MainActivity"
            android:exported="true"
            android:targetActivity=".infrastructure.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Brief You: the digest notification's Mark all read button. -->
        <receiver
            android:name="com.ay.briefyou.brief.notifications.DigestActionReceiver"
            android:exported="false" />
        <!-- Brief You: Read later, in the Share menu: saves a shared link as a starred article. -->
        <activity
            android:name="com.ay.briefyou.brief.readlater.ReadLaterActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/read_later_label"
            android:icon="@mipmap/ic_launcher"
            android:taskAffinity=""
            android:theme="@style/Theme.BriefYou.ReadLater">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".infrastructure.android.CrashReportActivity"
            android:exported="false"
            android:theme="@style/Theme.Reader"></activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Brief You: background work that shows progress (the AI model download) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Brief You: read aloud keeps reading outside the article, with a notification and Stop. -->
        <service
            android:name=".brief.readaloud.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Brief You: podcast episodes and videos, with their own media notification; Android's "resume" (lock screen, Quick Settings, after a restart) reaches it through the media button receiver. -->
        <service
            android:name=".brief.player.PlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <receiver
            android:name=".ui.widget.ArticleListWidgetReceiver"
            android:label="@string/list_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/article_list_widget_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.ArticleCardWidgetReceiver"
            android:label="@string/card_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/article_card_widget_info" />
        </receiver>
        <!-- Brief You: widgets placed before the package rename are bound to the old receiver names
             (tiny stubs in me/ash/reader/ui/widget). -->
        <receiver
            android:name="me.ash.reader.ui.widget.ArticleListWidgetReceiver"
            android:label="@string/list_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/article_list_widget_info" />
        </receiver>
        <receiver
            android:name="me.ash.reader.ui.widget.ArticleCardWidgetReceiver"
            android:label="@string/card_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/article_card_widget_info" />
        </receiver>
    </application>

</manifest>